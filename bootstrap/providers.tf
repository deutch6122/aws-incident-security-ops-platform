# ---------------------------------------------------------------------------
# AWS provider 設定
# ---------------------------------------------------------------------------
# リージョンは ap-northeast-1 固定（Req 19.3）。
# default_tags で全リソースへ Platform 識別タグを付与する（Req 19.2）。
# ---------------------------------------------------------------------------

provider "aws" {
  region = var.aws_region

  # 全リソースへ共通タグを付与（Req 19.2）。
  default_tags {
    tags = local.common_tags
  }
}
