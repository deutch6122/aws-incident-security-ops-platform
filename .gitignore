# =============================================================
# aws-incident-security-ops-platform .gitignore
# 機微ファイル（シークレット・ローカル state）を除外する (Req 16.3)
# =============================================================

# ---------- Terraform ----------
# ローカル state（remote backend で管理するため VCS には含めない）
*.tfstate
*.tfstate.*
.terraform/
.terraform.tfstate.lock.info
crash.log
crash.*.log
# ローカル上書き・環境固有の値
*.tfvars.local
terraform.tfvars
*.auto.tfvars
# backend.tf is a committed partial configuration. Account-specific bucket
# values are supplied at init time with -backend-config and are never committed.
override.tf
override.tf.json
*_override.tf
*_override.tf.json
# .terraform.lock.hcl is committed to pin provider selections.

# ---------- シークレット / 認証情報 ----------
.env
.env.*
*.pem
*.key
*.p12
*.pfx
credentials
aws-credentials
.aws/credentials
secrets.*
*.secret

# ---------- Python ----------
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
env/
.pytest_cache/
.hypothesis/
.mypy_cache/
.ruff_cache/
*.egg-info/
.coverage
htmlcov/

# ---------- Node ----------
node_modules/
dist/
build/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ---------- OS / エディタ ----------
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/

# Allow safe source modules named secrets.py.
# These files contain secret-reader code only, not real secret values.
!apps/backend-api/app/db/secrets.py
!apps/eks-workers/workers/db/secrets.py

/infra/modules/*/.terraform.lock.hcl