# ---------------------------------------------------------------------------
# infra/environments/dev の remote backend 設定例
# ---------------------------------------------------------------------------
# 実際の `backend.tf` は、実アカウント固有値を含まないpartial backend
# としてリポジトリへコミットします。この例をコピーしたり、bucket名を
# backend.tfへ書き込んだりしないでください。Bootstrap output
# `state_bucket_name` は次のようにinit時だけ供給します。
#
#   terraform init \
#     -backend-config="bucket=<bootstrap state_bucket_name>"
#
# state lock 方式（第一候補）:
#   `use_lockfile = true`（S3 ネイティブロック）を使用する。DynamoDB は不要。
#   Terraform v1.10 以降が前提（bootstrap/versions.tf の required_version >= 1.10）。
#   詳細は docs/architecture/terraform-backend-design.md を参照。
# 対応要件: Req 23.1, 23.2, 25.2
# ---------------------------------------------------------------------------

terraform {
  required_version = ">= 1.10"

  backend "s3" {
    key          = "environments/dev/terraform.tfstate"
    region       = "ap-northeast-1"
    encrypt      = true
    use_lockfile = true # 第一候補: S3 ネイティブロック（Terraform v1.10+）

    # DynamoDB lock tableへのフォールバックは使用しません。
  }
}
